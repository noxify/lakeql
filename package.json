{
  "name": "lakeql",
  "private": true,
  "license": "Apache-2.0",
  "author": {
    "name": "Marcus Reinhardt",
    "url": "https://github.com/noxify"
  },
  "maintainers": [
    {
      "name": "Marcus Reinhardt",
      "url": "https://github.com/noxify"
    }
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "dev:backend": "pnpm -F backend dev",
    "dev:ui": "pnpm -F ui dev",
    "preview:backend": "pnpm -F backend preview",
    "build": "turbo build",
    "dev:docs": "turbo dev --filter='docs'",
    "build:docs": "turbo build --filter='docs'",
    "preview:docs": "pnpm -F docs preview",
    "build:pkg": "turbo build --filter='@lakeql/*'",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo clean",
    "clean:dist": "turbo clean:dist",
    "clean:cache": "turbo clean:cache",
    "cli": "pnpm -F cli cli",
    "lint": "ultracite check",
    "lint:fix": "ultracite fix",
    "format": "oxfmt --check",
    "format:fix": "oxfmt .",
    "lint:ws": "sherif",
    "postinstall": "pnpm lint:ws",
    "typecheck": "turbo typecheck",
    "deps:check": "pnpm outdated -r",
    "deps:update": "pnpm update -i -L -r",
    "audit": "pnpm audit --prod",
    "audit:ci": "pnpm audit --prod --ignore GHSA-qx2v-qp2m-jg93 --ignore-unfixable",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "prune": "turbo prune --docker",
    "cs": "changeset",
    "ci:publish": "pnpm build:pkg && pnpm publish -r --access public --publish-branch main --provenance && pnpm changeset tag && git push --follow-tags",
    "ci:version": "pnpm changeset version && pnpm install --no-frozen-lockfile && pnpm format:fix && git add .",
    "with-env": "dotenv -e ./.env --",
    "mt:start": "uv run minitrino -v provision -m hive -m minio -m ldap -m oauth2",
    "mt:restart": "uv run minitrino restart",
    "mt:stop": "uv run minitrino down --keep",
    "mt:clean": "uv run minitrino down"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.0-next.5",
    "@vitest/coverage-v8": "4.1.9",
    "@vitest/ui": "4.1.9",
    "dotenv-cli": "11.0.0",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0",
    "sherif": "1.11.1",
    "turbo": "2.9.18",
    "typescript": "6.0.3",
    "ultracite": "7.8.3",
    "vite": "7.3.5",
    "vitest": "4.1.9"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.7.0"
}
