{
  "name": "@lakeql/fabric-client",
  "version": "0.1.0",
  "description": "TDS client for executing T-SQL queries on Microsoft Fabric SQL endpoints",
  "keywords": [
    "fabric",
    "lakeql",
    "microsoft",
    "mssql",
    "sql",
    "t-sql",
    "tds"
  ],
  "homepage": "https://lakeql.dev",
  "license": "Apache-2.0",
  "author": {
    "name": "Marcus Reinhardt",
    "url": "https://github.com/noxify"
  },
  "contributors": [
    {
      "name": "Marcus Reinhardt",
      "url": "https://github.com/noxify"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/noxify/lakeql",
    "directory": "packages/fabric-client"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "clean": "git clean -xdf .cache .turbo dist node_modules dist",
    "clean:cache": "git clean -xdf .cache .turbo",
    "clean:dist": "git clean -xdf dist",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@azure/identity": "4.14.0",
    "mssql": "12.7.13"
  },
  "devDependencies": {
    "@lakeql/tsconfig": "workspace:*",
    "@lakeql/vitest-config": "workspace:*",
    "@types/mssql": "12.3.0",
    "@types/node": "24.19.2",
    "tsdown": "0.23.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
