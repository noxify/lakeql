{
  "name": "@lakeql/cli",
  "version": "0.5.1",
  "description": "CLI for introspecting Trino schemas and generating type-safe GraphQL endpoints",
  "keywords": [
    "cli",
    "codegen",
    "graphql",
    "lakeql",
    "schema",
    "trino"
  ],
  "homepage": "https://lakeql.dev",
  "bugs": "https://github.com/noxify/lakeql/issues",
  "license": "Apache-2.0",
  "author": {
    "name": "Marcus Reinhardt",
    "url": "https://github.com/noxify"
  },
  "contributors": [
    {
      "name": "Marcus Reinhardt",
      "url": "https://github.com/noxify"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/noxify/lakeql",
    "directory": "packages/cli"
  },
  "bin": {
    "lakeql-cli": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    },
    "./cli": {
      "import": "./dist/cli.mjs"
    },
    "./commands-metadata": {
      "import": "./dist/commands-metadata.mjs",
      "types": "./dist/commands-metadata.d.mts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "clean": "git clean -xdf .cache .turbo dist node_modules dist",
    "clean:cache": "git clean -xdf .cache .turbo",
    "clean:dist": "git clean -xdf dist",
    "cli": "tsx src/cli.ts",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@commander-js/extra-typings": "15.0.0",
    "@lakeql/column-parser": "workspace:*",
    "@lakeql/file-generator": "workspace:*",
    "@lakeql/helpers": "workspace:*",
    "@lakeql/logger": "workspace:*",
    "@lakeql/response-transformer": "workspace:*",
    "@lakeql/schema-generator": "workspace:*",
    "@lakeql/trino-client": "workspace:*",
    "@t3-oss/env-core": "0.13.11",
    "@topcli/prompts": "3.1.0",
    "c12": "4.0.0-beta.5",
    "climt": "0.2.0",
    "commander": "15.0.0",
    "globby": "16.2.0",
    "handlebars": "4.7.9",
    "listr2": "10.2.1",
    "lodash-es": "4.18.1",
    "read-pkg": "10.1.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@lakeql/tsconfig": "workspace:*",
    "@types/lodash-es": "4.17.12",
    "@types/node": "24.13.2",
    "fast-check": "^4.8.0",
    "tsdown": "0.22.3",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  }
}
