{
  "name": "@lakeql/helpers",
  "version": "0.1.7",
  "description": "Shared utility functions for pagination, formatting, and object manipulation",
  "keywords": [
    "formatting",
    "helpers",
    "lakeql",
    "pagination",
    "utilities"
  ],
  "homepage": "https://lakeql.dev",
  "license": "Apache-2.0",
  "author": {
    "name": "Marcus Reinhardt",
    "url": "https://github.com/noxify"
  },
  "contributors": [
    {
      "name": "Marcus Reinhardt",
      "url": "https://github.com/noxify"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/noxify/lakeql",
    "directory": "packages/helpers"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./calculate-page-info": {
      "types": "./dist/calculate-page-info.d.mts",
      "import": "./dist/calculate-page-info.mjs"
    },
    "./format-code": {
      "types": "./dist/format-code.d.mts",
      "import": "./dist/format-code.mjs"
    },
    "./object-helper": {
      "types": "./dist/object-helper.d.mts",
      "import": "./dist/object-helper.mjs"
    },
    "./special-characters": {
      "types": "./dist/special-characters.d.mts",
      "import": "./dist/special-characters.mjs"
    },
    "./string-case": {
      "types": "./dist/string-case.d.mts",
      "import": "./dist/string-case.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "clean": "git clean -xdf .cache .turbo dist node_modules dist",
    "clean:cache": "git clean -xdf .cache .turbo",
    "clean:dist": "git clean -xdf dist",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "es-toolkit": "1.53.2"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@lakeql/tsconfig": "workspace:*",
    "@lakeql/vitest-config": "workspace:*",
    "@types/node": "24.19.2",
    "prettier": "3.9.10",
    "tsdown": "0.23.7",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
