{
  "name": "@lakeql/adapters",
  "version": "0.6.1",
  "description": "Storage adapters for LakeQL — provides high-level table management for different backends (Trino/Hive/S3, Iceberg, ClickHouse, etc.)",
  "keywords": [
    "adapters",
    "clickhouse",
    "hive",
    "iceberg",
    "lakeql",
    "parquet",
    "s3",
    "trino"
  ],
  "homepage": "https://lakeql.dev",
  "license": "Apache-2.0",
  "author": {
    "name": "Marcus Reinhardt",
    "url": "https://github.com/noxify"
  },
  "contributors": [
    {
      "name": "Marcus Reinhardt",
      "url": "https://github.com/noxify"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/noxify/lakeql",
    "directory": "packages/adapters"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./trino-hive-s3": {
      "types": "./dist/trino-hive-s3.d.mts",
      "import": "./dist/trino-hive-s3.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "clean": "git clean -xdf .cache .turbo dist node_modules dist",
    "clean:cache": "git clean -xdf .cache .turbo",
    "clean:dist": "git clean -xdf dist",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lakeql/parquet": "workspace:*",
    "@lakeql/schema-generator": "workspace:*",
    "@lakeql/trino-client": "workspace:*",
    "files-sdk": "2.2.0"
  },
  "devDependencies": {
    "@lakeql/tsconfig": "workspace:*",
    "@types/node": "24.13.3",
    "fast-check": "^4.9.0",
    "tsdown": "0.22.13",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/lib-storage": "^3.700.0",
    "@aws-sdk/s3-presigned-post": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@aws-sdk/lib-storage": {
      "optional": true
    },
    "@aws-sdk/s3-presigned-post": {
      "optional": true
    },
    "@aws-sdk/s3-request-presigner": {
      "optional": true
    }
  }
}
