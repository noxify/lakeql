{
  "name": "@lakeql/sql-read-strategy",
  "version": "0.1.0",
  "description": "Shared SQL read orchestration for LakeQL adapters",
  "keywords": [
    "lakeql",
    "read-strategy",
    "sql"
  ],
  "homepage": "https://lakeql.dev",
  "license": "Apache-2.0",
  "author": {
    "name": "Marcus Reinhardt",
    "url": "https://github.com/noxify"
  },
  "contributors": [
    {
      "name": "Marcus Reinhardt",
      "url": "https://github.com/noxify"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/noxify/lakeql",
    "directory": "packages/sql-read-strategy"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "clean": "git clean -xdf .cache .turbo dist node_modules dist",
    "clean:cache": "git clean -xdf .cache .turbo",
    "clean:dist": "git clean -xdf dist",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lakeql/datasource": "workspace:*",
    "@lakeql/helpers": "workspace:*",
    "@lakeql/query-builder": "workspace:*",
    "@lakeql/response-transformer": "workspace:*"
  },
  "devDependencies": {
    "@lakeql/tsconfig": "workspace:*",
    "@lakeql/vitest-config": "workspace:*",
    "@types/node": "24.19.2",
    "kysely": "0.29.7",
    "tsdown": "0.23.2",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
