{
  "name": "@lakeql/parquet",
  "version": "0.1.0",
  "description": "JSON Schema to Parquet conversion and writing for LakeQL",
  "keywords": [
    "columnar",
    "hyparquet",
    "json-schema",
    "lakeql",
    "parquet"
  ],
  "homepage": "https://lakeql.dev",
  "license": "Apache-2.0",
  "author": {
    "name": "Marcus Reinhardt",
    "url": "https://github.com/noxify"
  },
  "contributors": [
    {
      "name": "Marcus Reinhardt",
      "url": "https://github.com/noxify"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/noxify/lakeql",
    "directory": "packages/parquet"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "clean": "git clean -xdf .cache .turbo dist node_modules dist",
    "clean:cache": "git clean -xdf .cache .turbo",
    "clean:dist": "git clean -xdf dist",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hyparquet-writer": "0.15.6"
  },
  "devDependencies": {
    "@lakeql/tsconfig": "workspace:*",
    "@types/node": "24.13.2",
    "fast-check": "^4.8.0",
    "hyparquet": "1.26.0",
    "tsdown": "0.22.2",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
