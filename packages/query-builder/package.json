{
  "name": "@lakeql/query-builder",
  "version": "0.1.2",
  "description": "Kysely-based SQL query builder that translates GraphQL queries into Trino SQL",
  "keywords": [
    "graphql",
    "kysely",
    "lakeql",
    "query-builder",
    "sql",
    "trino"
  ],
  "homepage": "https://lakeql.dev",
  "license": "Apache-2.0",
  "author": {
    "name": "Marcus Reinhardt",
    "url": "https://github.com/noxify"
  },
  "contributors": [
    {
      "name": "Marcus Reinhardt",
      "url": "https://github.com/noxify"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/noxify/lakeql",
    "directory": "packages/query-builder"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "clean": "git clean -xdf .cache .turbo dist node_modules dist",
    "clean:cache": "git clean -xdf .cache .turbo",
    "clean:dist": "git clean -xdf dist",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "date-fns": "4.4.0",
    "kysely": "0.29.2",
    "sql-formatter": "15.8.1"
  },
  "devDependencies": {
    "@lakeql/tsconfig": "workspace:*",
    "@pothos/core": "4.12.0",
    "@types/node": "24.13.2",
    "graphql": "16.14.2",
    "tsdown": "0.22.2",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
