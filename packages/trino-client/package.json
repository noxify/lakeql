{
  "name": "@lakeql/trino-client",
  "version": "0.3.1",
  "description": "HTTP client for executing queries and inspecting metadata on Trino clusters",
  "keywords": [
    "http-client",
    "lakeql",
    "rest-api",
    "sql",
    "trino"
  ],
  "homepage": "https://lakeql.dev",
  "license": "Apache-2.0",
  "author": {
    "name": "Marcus Reinhardt",
    "url": "https://github.com/noxify"
  },
  "contributors": [
    {
      "name": "Marcus Reinhardt",
      "url": "https://github.com/noxify"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/noxify/lakeql",
    "directory": "packages/trino-client"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "clean": "git clean -xdf .cache .turbo dist node_modules dist",
    "clean:cache": "git clean -xdf .cache .turbo",
    "clean:dist": "git clean -xdf dist",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@lakeql/tsconfig": "workspace:*",
    "@types/node": "24.13.2",
    "msw": "2.14.6",
    "tsdown": "0.22.2",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  }
}
