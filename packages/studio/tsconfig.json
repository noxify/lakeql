{
  "extends": "@lakeql/tsconfig/base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "node_modules/.cache/tsbuildinfo.json",
    "lib": ["dom", "dom.iterable", "ESNext"],
    "jsx": "react-jsx",
    "strictNullChecks": true,
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["*.ts", "src", "tests"],
  "exclude": ["node_modules", "dist"]
}
