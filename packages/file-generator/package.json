{
  "name": "@lakeql/file-generator",
  "version": "0.1.12",
  "description": "Generates TypeScript source files from Trino table metadata",
  "keywords": [
    "ast",
    "codegen",
    "lakeql",
    "trino",
    "typescript"
  ],
  "homepage": "https://lakeql.dev",
  "license": "Apache-2.0",
  "author": {
    "name": "Marcus Reinhardt",
    "url": "https://github.com/noxify"
  },
  "contributors": [
    {
      "name": "Marcus Reinhardt",
      "url": "https://github.com/noxify"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/noxify/lakeql",
    "directory": "packages/file-generator"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./config": {
      "types": "./dist/config.d.mts",
      "import": "./dist/config.mjs"
    },
    "./config-registry": {
      "types": "./dist/config-registry.d.mts",
      "import": "./dist/config-registry.mjs"
    },
    "./interface": {
      "types": "./dist/interface.d.mts",
      "import": "./dist/interface.mjs"
    },
    "./mutation-schema": {
      "types": "./dist/mutation-schema.d.mts",
      "import": "./dist/mutation-schema.mjs"
    },
    "./query-schema": {
      "types": "./dist/query-schema.d.mts",
      "import": "./dist/query-schema.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "clean": "git clean -xdf .cache .turbo dist node_modules dist",
    "clean:cache": "git clean -xdf .cache .turbo",
    "clean:dist": "git clean -xdf dist",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lakeql/helpers": "workspace:*",
    "@lakeql/schema-generator": "workspace:*",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@lakeql/column-parser": "workspace:*",
    "@lakeql/tsconfig": "workspace:*",
    "@types/json-schema": "7.0.15",
    "@types/node": "24.13.2",
    "lodash-es": "4.18.1",
    "tsdown": "0.22.3",
    "vitest": "4.1.9"
  }
}
