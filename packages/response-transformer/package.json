{
  "name": "@lakeql/response-transformer",
  "version": "0.1.5",
  "description": "Transforms Trino array responses into typed JavaScript objects",
  "keywords": [
    "lakeql",
    "mapping",
    "response",
    "transform",
    "trino"
  ],
  "homepage": "https://lakeql.dev",
  "license": "Apache-2.0",
  "author": {
    "name": "Marcus Reinhardt",
    "url": "https://github.com/noxify"
  },
  "contributors": [
    {
      "name": "Marcus Reinhardt",
      "url": "https://github.com/noxify"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/noxify/lakeql",
    "directory": "packages/response-transformer"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "clean": "git clean -xdf .cache .turbo dist node_modules dist",
    "clean:cache": "git clean -xdf .cache .turbo",
    "clean:dist": "git clean -xdf dist",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@formkit/tempo": "1.1.0"
  },
  "devDependencies": {
    "@faker-js/faker": "10.5.0",
    "@lakeql/tsconfig": "workspace:*",
    "@types/node": "24.13.2",
    "@valibot/to-json-schema": "1.7.1",
    "tsdown": "0.22.3",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "valibot": "1.4.1",
    "vitest": "4.1.9"
  }
}
