{
  "name": "@lakeql/api",
  "version": "0.3.2",
  "description": "GraphQL API server using Hono, GraphQL Yoga, and Pothos over your data sources",
  "keywords": [
    "api",
    "graphql",
    "hono",
    "lakeql",
    "pothos",
    "trino",
    "yoga"
  ],
  "homepage": "https://lakeql.dev",
  "bugs": "https://github.com/noxify/lakeql/issues",
  "license": "Apache-2.0",
  "author": {
    "name": "Marcus Reinhardt",
    "url": "https://github.com/noxify"
  },
  "contributors": [
    {
      "name": "Marcus Reinhardt",
      "url": "https://github.com/noxify"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/noxify/lakeql",
    "directory": "packages/api"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./*": {
      "types": "./dist/*.d.mts",
      "import": "./dist/*.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "clean": "git clean -xdf .cache .turbo dist node_modules dist",
    "clean:cache": "git clean -xdf .cache .turbo",
    "clean:dist": "git clean -xdf dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@lakeql/config": "workspace:*",
    "@lakeql/datasource": "workspace:*",
    "@lakeql/logger": "workspace:*",
    "@pothos/core": "4.16.0",
    "@pothos/plugin-scope-auth": "4.2.2",
    "@pothos/plugin-validation": "4.3.5",
    "@t3-oss/env-core": "0.13.11",
    "dedent": "1.7.2",
    "globby": "16.2.4",
    "graphql": "17.0.2",
    "graphql-scalars": "2.0.1",
    "graphql-yoga": "6.0.1",
    "hono": "4.13.14",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@lakeql/tsconfig": "workspace:*",
    "@lakeql/vitest-config": "workspace:*",
    "@standard-schema/spec": "1.1.0",
    "@types/json-schema": "7.0.15",
    "@types/node": "24.19.2",
    "dotenv-cli": "11.1.0",
    "tsdown": "0.23.3",
    "tsx": "4.23.15",
    "type-fest": "5.10.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
