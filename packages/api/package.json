{
  "name": "@lakeql/api",
  "version": "0.2.6",
  "description": "GraphQL API server using Hono, GraphQL Yoga, and Pothos over Trino",
  "keywords": [
    "api",
    "graphql",
    "hono",
    "lakeql",
    "pothos",
    "trino",
    "yoga"
  ],
  "homepage": "https://lakeql.dev",
  "bugs": "https://github.com/noxify/lakeql/issues",
  "license": "Apache-2.0",
  "author": {
    "name": "Marcus Reinhardt",
    "url": "https://github.com/noxify"
  },
  "contributors": [
    {
      "name": "Marcus Reinhardt",
      "url": "https://github.com/noxify"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/noxify/lakeql",
    "directory": "packages/api"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./*": {
      "types": "./dist/*.d.mts",
      "import": "./dist/*.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "clean": "git clean -xdf .cache .turbo dist node_modules dist",
    "clean:cache": "git clean -xdf .cache .turbo",
    "clean:dist": "git clean -xdf dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "2.0.6",
    "@lakeql/helpers": "workspace:*",
    "@lakeql/logger": "workspace:*",
    "@lakeql/query-builder": "workspace:*",
    "@lakeql/response-transformer": "workspace:*",
    "@lakeql/trino-client": "workspace:*",
    "@pothos/core": "4.13.0",
    "@pothos/plugin-scope-auth": "4.1.6",
    "@pothos/plugin-validation": "4.3.0",
    "@t3-oss/env-core": "0.13.11",
    "dedent": "1.7.2",
    "globby": "16.2.0",
    "graphql": "16.14.2",
    "graphql-scalars": "1.25.0",
    "graphql-yoga": "5.21.2",
    "hono": "4.12.26",
    "jose": "6.2.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@lakeql/tsconfig": "workspace:*",
    "@standard-schema/spec": "1.1.0",
    "@types/json-schema": "7.0.15",
    "@types/node": "24.13.2",
    "dotenv-cli": "11.0.0",
    "tsdown": "0.22.3",
    "tsx": "4.22.4",
    "type-fest": "5.7.0",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  }
}
