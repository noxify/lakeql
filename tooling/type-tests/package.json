{
  "name": "@lakeql/type-tests",
  "version": "0.0.0",
  "private": true,
  "description": "Compile-time type assertions that span multiple packages without adding cross-dependencies",
  "type": "module",
  "scripts": {
    "test": "vitest --typecheck",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@lakeql/adapter-fabric": "workspace:*",
    "@lakeql/adapter-trino": "workspace:*",
    "@lakeql/config": "workspace:*",
    "@lakeql/tsconfig": "workspace:*",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
