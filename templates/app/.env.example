######
# Mock auth (local development)
######
AUTH_MOCK=true
AUTH_MOCK_TOKEN="1234"

######
# GraphQL API
# Optional — the shown values are the defaults used when unset.
######
API_PORT=4000
API_LOGGER="warn"

