{
  "name": "lakeql-app",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "clean:cache": "git clean -xdf .cache .turbo",
    "clean:dist": "git clean -xdf dist",
    "dev": "node --env-file=.env --import tsx ./src/index.ts",
    "preview": "node --env-file=.env ./dist/index.mjs",
    "start": "node ./dist/index.mjs",
    "typecheck": "tsc --noEmit",
    "cli": "lakeql-cli --env=.env"
  },
  "dependencies": {
    "@lakeql/api": "workspace:*",
    "@lakeql/config": "workspace:*",
    "@lakeql/datasource": "workspace:*",
    "@lakeql/query-builder": "workspace:*",
    "@t3-oss/env-core": "0.13.11",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@lakeql/cli": "workspace:*",
    "@types/json-schema": "7.0.15",
    "@types/node": "24.19.2",
    "tsdown": "0.23.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
